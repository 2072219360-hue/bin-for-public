{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2017-x64-debug",
      "displayName": "VS2017 environment + Ninja x64 Debug",
      "description": "Conservative parallel build; does not modify the legacy VS/qmake projects.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/vs2017-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2017-x64-debug",
      "configurePreset": "vs2017-x64-debug",
      "jobs": 1
    }
  ]
}
